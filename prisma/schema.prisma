generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int    @id @default(autoincrement())
  first_name String @db.VarChar(100)
  last_name  String @db.VarChar(100)

  @@map("users")
}
